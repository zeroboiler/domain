{
  "$schema": "https://raw.githubusercontent.com/laravel/pint/main/resources/pint.schema.json",
  "preset": "laravel",
  "rules": {
    "declare_strict_types": true,
    "ordered_imports": {
      "sort_algorithm": "alpha",
      "imports_order": ["class", "function", "const"]
    },
    "blank_line_before_statement": {
      "statements": ["return", "try", "if", "throw", "for", "while", "do"]
    },
    "concat_space": {
      "spacing": "one"
    },
    "binary_operator_spaces": {
      "default": "single_space"
    },
    "function_declaration": {
      "closure_function_spacing": "one",
      "closure_fn_spacing": "one"
    },
    "class_attributes_separation": {
      "elements": {
        "const": "none",
        "method": "one",
        "property": "one",
        "trait_import": "none",
        "case": "none"
      }
    }
  }
}
{
    "name": "zeroboiler/domain",
    "description": "Zero-boilerplate DDD building blocks: aggregate roots, entities, value objects, domain events, repository contracts and unit of work for Laravel",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "ramsey/uuid": "^4.7",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0",
        "rector/rector": "^2.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ZeroBoiler\\Domain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroBoiler\\Domain\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "rector": "rector",
        "ci": [
            "@lint",
            "@analyse",
            "@rector",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroBoiler\\Domain\\DomainServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
{
    "name": "zeroboiler/domain",
    "description": "DDD building blocks for rich domain models with aggregate roots, entities, value objects, and domain events",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "domain-driven-design", "aggregate-root", "value-object", "domain-event"],
    "authors": [
        {
            "name": "ZeroBoiler",
            "email": "hello@zeroboiler.dev"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "ramsey/uuid": "^4.7",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-type-coverage": "^3.0",
        "rector/rector": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "ZeroBoiler\\Domain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroBoiler\\Domain\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroBoiler\\Domain\\DomainServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint",
        "lint:fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "rector": "vendor/bin/rector process",
        "quality": [
            "@lint",
            "@analyse",
            "@rector",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
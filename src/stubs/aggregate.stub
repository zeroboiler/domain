use ZeroBoiler\Events\Domain\DomainEvent;

/**
 * {{ class }} — domain aggregate root.
 *
 * Business rules and invariant enforcement live here.
 * State mutations are driven by domain events via the apply() method.
 *
 * Add domain properties as public typed fields. The EventSourced trait
 * enables reconstitution from event history via fromHistory().
 *
 * @since 1.0.0
 *
 * @example
 * ```php
 * // Create
 * $order = {{ class }}::create(AggregateRootId::generate());
 *
 * // Mutate state via events
 * $order->doSomething();
 *
 * // Pull events for dispatch
 * $events = $order->pullDomainEvents();
 *
 * // Reconstitute from history
 * $order = {{ class }}::fromHistory(...$events);
 * ```
 */
final class {{ class }} extends AggregateRoot
{
    use EventSourced;

    // Add domain properties here:
    // public string $status = 'pending';

    /**
     * Create a new {{ name }} aggregate.
     *
     * Records a creation event that initializes aggregate state.
     * All state mutations go through events for full audit trail.
     *
     * @param  AggregateRootId  $id  The unique aggregate identity.
     * @return self
     */
    public static function create(AggregateRootId $id): self
    {
        $aggregate = new self($id);

        $aggregate->apply(DomainEvent::occur('{{ class }}.created', [
            'id' => $id->toString(),
        ]));

        return $aggregate;
    }


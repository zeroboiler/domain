namespace {{ namespace }};

use {{ rootNamespace }}Domain\Aggregates\{{ name }};
use ZeroBoiler\Domain\Contracts\Repository;

/**
 * {{ class }} — aggregate root repository.
 *
 * Extend this interface to add domain-specific query methods.
 * The domain defines only the contract; implementations live in the
 * persistence layer (zeroboiler/persistence) or as in-memory fakes for tests.
 * Implementations must enforce optimistic locking via version comparison
 * on save().
 *
 * @since 1.13.0
 *
 * @example
 * ```php
 * // Interface definition (generated)
 * interface OrderRepository extends Repository
 * {
 *     public function findById(string $id): ?Order;
 * }
 *
 * // Persistence adapter (zeroboiler/persistence or your own)
 * final class DbalOrderRepository implements OrderRepository
 * {
 *     public function find(string|int $id): ?AggregateRoot
 *     {
 *         $row = $this->connection->fetchOne(
 *             'SELECT state FROM orders WHERE id = ?',
 *             [$id],
 *         );
 *
 *         return $row === false ? null : Order::fromArray(json_decode($row, true));
 *     }
 *
 *     public function save(AggregateRoot $aggregate): void
 *     {
 *         $persisted = $this->find($aggregate->id());
 *
 *         if ($persisted !== null && $persisted->version() !== $aggregate->version()) {
 *             throw OptimisticLockException::for(
 *                 $aggregate->id(),
 *                 expectedVersion: $aggregate->version(),
 *                 actualVersion: $persisted->version(),
 *             );
 *         }
 *
 *         $this->connection->executeStatement(
 *             'UPSERT INTO orders (id, version, state) VALUES (?, ?, ?)',
 *             [$aggregate->id(), $aggregate->version() + 1, json_encode($aggregate->toArray())],
 *         );
 *         $aggregate->incrementVersion();
 *     }
 *
 *     public function delete(string|int $id): void
 *     {
 *         $this->connection->executeStatement('DELETE FROM orders WHERE id = ?', [$id]);
 *     }
 * }
 * ```
 */
interface {{ class }} extends Repository
{
    /**
     * Find an aggregate by its string identifier.
     *
     * @param  string  $id  The aggregate identity.
     * @return {{ name }}|null The aggregate, or null if not found.
     */
    public function findById(string $id): ?{{ name }};
}
